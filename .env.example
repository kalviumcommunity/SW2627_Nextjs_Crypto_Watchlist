# NextAuth Secret
AUTH_SECRET="coindcx-auth-secret-key-12345"

# Google OAuth Credentials (Get from Google Cloud Console: https://console.cloud.google.com/)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

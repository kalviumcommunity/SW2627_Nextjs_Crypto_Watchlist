generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Watchlist {
  id        String          @id @default(cuid())
  name      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  items     WatchlistItem[]
}

model Coin {
  id                String          @id @default(cuid())
  symbol            String          @unique
  name              String
  subtext           String
  rank              Int
  iconUrl           String?
  network           String?
  description       String?
  websiteUrl        String?
  whitepaperUrl     String?
  circulatingSupply String?
  maxSupply         String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  priceSnapshots    PriceSnapshot[]
  watchlistItems    WatchlistItem[]
}

model PriceSnapshot {
  id           String   @id @default(cuid())
  coinId       String
  priceInr     Float
  change24hPct Float
  low24h       Float?
  high24h      Float?
  volume24h    String
  marketCap    String
  sparkline7d  String
  recordedAt   DateTime @default(now())
  coin         Coin     @relation(fields: [coinId], references: [id], onDelete: Cascade)

  @@index([coinId, recordedAt])
}

model WatchlistItem {
  id          String    @id @default(cuid())
  coinId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  watchlistId String
  coin        Coin      @relation(fields: [coinId], references: [id], onDelete: Cascade)
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, coinId])
}

// This is your Prisma schema file
datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

model Coin {
  id             String          @id @default(cuid())
  symbol         String          @unique
  name           String
  subtext        String
  rank           Int
  iconUrl        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  priceSnapshots PriceSnapshot[]
  watchlistItems WatchlistItem[]
}

model PriceSnapshot {
  id           String   @id @default(cuid())
  coinId       String
  coin         Coin     @relation(fields: [coinId], references: [id], onDelete: Cascade)
  priceInr     Float
  change24hPct Float
  volume24h    String
  marketCap    String
  sparkline7d  String   // JSON stringified numbers array for 7-day trend
  recordedAt   DateTime @default(now())

  @@index([coinId, recordedAt])
}

model Watchlist {
  id        String          @id @default(cuid())
  name      String          @default("My Watchlist")
  createdAt DateTime        @default(now())
  items     WatchlistItem[]
}

model WatchlistItem {
  id          String    @id @default(cuid())
  watchlistId String
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  coinId      String
  coin        Coin      @relation(fields: [coinId], references: [id], onDelete: Cascade)
  addedAt     DateTime  @default(now())

  @@unique([watchlistId, coinId])
}

